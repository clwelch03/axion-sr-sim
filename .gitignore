# Regenerable outputs and bytecode caches -- see runs/.gitignore for the
# same convention applied to heavy run artifacts.
__pycache__/
*.pyc
# Private chat snapshots and recovery receipts.
/recovery/chat-retrieval/
# Keep Julia checkpoints local (CSV data tables are tracked).
*.jls
# Generated campaign results, including TOML/JSON summaries and failure reports.
/runs/**/results/
